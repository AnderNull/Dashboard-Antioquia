# ── NextAuth v5 ─────────────────────────────────────────────
# Genera uno con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── Google Sheets (Service Account) ────────────────────────
# ID que aparece en la URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=nombre@proyecto.iam.gserviceaccount.com
# Pega la clave entre comillas, con los saltos de línea como \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Anthropic (Claude) ─────────────────────────────────────
ANTHROPIC_API_KEY=
# Opcional. Por defecto: claude-sonnet-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5
